// Cloudflare Worker for mentifaber.org: the repo root is served as static
// assets, and src/worker.js handles /api/* and the sealed pages first.
{
  "name": "mentifaber-1",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/*", "/p/*",
      "/store/*", "/store.apk", "/autofaber.apk", "/android",
      "/vigil-app", "/vigil-app.html",
      "/flutterbloom", "/flutterbloom.html",
      "/muse-live", "/muse-live.html",
      "/weaver-live", "/weaver-live.html",
      "/graveyard-app", "/graveyard-app.html",
      "/rootcause-app", "/rootcause-app.html",
      "/sideways-app", "/sideways-app.html",
      "/angels", "/angels.html"
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }, { "name": "LOBBY", "class_name": "Lobby" }, { "name": "HIVE", "class_name": "Hive" }, { "name": "NULLSPACE", "class_name": "Nullspace" }, { "name": "AGENT", "class_name": "Agent" }, { "name": "NEST", "class_name": "Nest" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }, { "tag": "v2", "new_sqlite_classes": ["Lobby"] }, { "tag": "v3", "new_sqlite_classes": ["Hive"] }, { "tag": "v4", "new_sqlite_classes": ["Nullspace"] }, { "tag": "v5", "new_sqlite_classes": ["Agent"] }, { "tag": "v6", "new_sqlite_classes": ["Nest"] }],
  // Workers AI: the Hive's swarm (src/hive.js). Optional extra providers are Worker secrets:
  // OPENROUTER_KEY, GROQ_KEY, GEMINI_KEY (wrangler secret put …). Owner keys added at /hive#keys are sealed in the
  // Hive DO; set HIVE_VAULT_SECRET to seal them with a key that lives outside the DO.
  "ai": { "binding": "AI" },
  // R2 is switched off on this account (Cloudflare refuses every deploy that binds a bucket while it is), so there is no
  // MODELS binding: the Nest Registry keeps its photos and daily copies in its own Durable Object, the store serves APKs
  // from GitHub, and MENTIFABER AGENT has nowhere for its model file. Once R2 is enabled again in the dashboard, add back:
  //   "r2_buckets": [{ "binding": "MODELS", "bucket_name": "mentifaber-models" }],
  // and the registry reads photos from either place.
  // Containers (MENTIFABER AGENT's own model) need the Workers Paid plan. To bring the agent back on a paid plan, add:
  //   "containers": [{ "class_name": "Agent", "image": "./agent/Dockerfile", "instance_type": "standard-4", "max_instances": 1 }],
  // Hourly: Flutterbloom's daily reminder and Genesis's tick. Every 15 minutes: Genesis keeps watch on Vigil's board.
  "triggers": { "crons": ["7 * * * *", "*/15 * * * *"] }
}
